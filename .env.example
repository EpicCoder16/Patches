# Patches — environment config
# Copy this file to .env and fill in your values.

# Get a free API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza-your-key-here

# Model to use (optional — defaults to gemini-3.8-flash)
# Options (v1beta generateContent — keep synced with https://ai.google.dev/gemini-api/docs/models):
#   gemini-3.8-flash
#   gemini-3.7-flash
#   gemini-3.6-flash
#   gemini-3.5-flash-lite
PATCHES_MODEL=gemini-3.8-flash

# Firebase (required — login & cloud patch storage)
# Create a project at https://console.firebase.google.com/
# Enable Authentication → Email/Password, and Cloud Firestore.
# Deploy firestore.rules from this repo, then paste your web app config:
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
