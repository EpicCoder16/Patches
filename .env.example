# Patches — environment config
# Copy this file to .env and fill in your values.

# Get a free API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza-your-key-here

# Model to use (optional — defaults to gemini-2.5-flash)
# Options (v1beta generateContent):
#   gemini-2.5-flash
#   gemini-2.5-pro
#   gemini-2.0-flash
#   gemini-2.0-flash-lite
PATCHES_MODEL=gemini-2.5-flash

# Firebase (required — login & cloud patch storage)
# Create a project at https://console.firebase.google.com/
# Enable Authentication → Email/Password, and Cloud Firestore.
# Deploy firestore.rules from this repo, then paste your web app config:
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
